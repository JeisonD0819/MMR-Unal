<?xml version="1.0"?>
<robot name="arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <!-- Propiedades del robot -->
  <xacro:property name="arm_base_length" value="0.1"/>
  <xacro:property name="arm_base_width" value="0.1"/>
  <xacro:property name="arm_base_height" value="0.02"/>
  <xacro:property name="forearm_radius" value="0.02"/>
  <xacro:property name="forearm_length" value="0.3"/>
  <xacro:property name="hand_radius" value="0.02"/>
  <xacro:property name="hand_length" value="0.3"/>
  <xacro:property name="R_arm3" value="0.02"/>
  <xacro:property name="arm3" value="0.2"/>

  <!-- ==================== 1. BASE ==================== -->
  <link name="arm_base_link">
    <visual>
      <geometry>
        <box size="${arm_base_length} ${arm_base_width} ${arm_base_height}"/>
      </geometry>
      <origin xyz="0 0 ${arm_base_height / 2.0}" rpy="0 0 0"/>
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <!-- ==================== 2. HOMBRO (ROTACIÓN Z) ==================== -->
  <!-- Articulación de rotación en Z (Giro horizontal) -->
  <joint name="arm_joint1" type="revolute">
    <parent link="arm_base_link"/>
    <child link="shoulder_dummy_link"/>
    <origin xyz="0 0 ${arm_base_height}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/> <!-- Rotación en Z -->
    <limit lower="-${pi}" upper="${pi}" effort="100" velocity="100"/>
    <dynamics friction="0.05" damping="0.1"/>
  </joint>

  <!-- Eslabón virtual intermedio para permitir el segundo grado de libertad -->
  <link name="shoulder_dummy_link"/>

  <!-- ==================== 3. ANTEBRAZO (ROTACIÓN Y) ==================== -->
  <!-- Articulación de rotación en Y (Elevación vertical) -->
  <joint name="arm_joint2" type="revolute">
    <parent link="shoulder_dummy_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> <!-- Rotación en Y -->
    <limit lower="0" upper="${pi/2}" effort="100" velocity="100"/>
    <dynamics friction="0.05" damping="0.1"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <geometry>
        <cylinder radius="${forearm_radius}" length="${forearm_length}"/>
      </geometry>
      <!-- Desplazamos el cilindro para que rote desde su base inferior -->
      <origin xyz="0 0 ${forearm_length / 2.0}" rpy="0 0 0"/>
      <material name="yellow">
        <color rgba="1.0 1.0 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <!-- ==================== 4. MANO (ROTACIÓN Y o Z) ==================== -->
  <!-- Conectamos el antebrazo con la mano -->
  <joint name="arm_joint3" type="revolute">
    <parent link="forearm_link"/>
    <child link="hand_link"/>
    <origin xyz="0 0 ${forearm_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> <!-- Cambia a "0 0 1" si quieres que la mano gire sobre su propio eje Z -->
    <limit lower="0" upper="${pi/2}" effort="100" velocity="100"/>
    <dynamics friction="0.05" damping="0.1"/>
  </joint>

  <link name="hand_link">
    <visual>
      <geometry>
        <cylinder radius="${hand_radius}" length="${hand_length}"/>
      </geometry>
      <origin xyz="0 0 ${hand_length / 2.0}" rpy="0 0 0"/>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="arm_joint4" type="revolute">
    <parent link="hand_link"/>
    <child link="arm_link3"/>
    <origin xyz="0 0 ${forearm_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> <!-- Cambia a "0 0 1" si quieres que la mano gire sobre su propio eje Z -->
    <limit lower="0" upper="${pi/2}" effort="100" velocity="100"/>
    <dynamics friction="0.05" damping="0.1"/>
  </joint>

  <link name="arm_link3">
    <visual>
      <geometry>
        <cylinder radius="${R_arm3}" length="${arm3}"/>
      </geometry>
      <origin xyz="0 0 ${arm3 / 2.0}" rpy="0 0 0"/>
      <material name="orange"/>
    </visual>
  </link>

</robot>
